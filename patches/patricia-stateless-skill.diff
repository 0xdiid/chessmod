@@ -1,5 +1,9 @@
 #include "search.h"
 
+#ifndef ACCUM_EST_MULT
+#define ACCUM_EST_MULT 4
+#endif
+
 void multipv_search(Position &position, ThreadInfo &thread_info) {
 
   thread_info.multipv = 5;
@@ -24,6 +28,19 @@ void search_human(Position &position, ThreadInfo &thread_info) {
 
   int starting_mat = material_eval(position);
 
+  // Plies into the game, counting the FEN's fullmove field, so a bare
+  // "position fen" in a fresh process is not treated as the opening.
+  int ply = thread_info.fen_ply + thread_info.game_ply - 6;
+
+  // The loss budget normally accumulates across moves in one process. Take it
+  // from Accum_Loss when given; otherwise draw a stateless estimate.
+  if (thread_info.accum_loss_override >= 0) {
+    thread_info.cp_accum_loss = thread_info.accum_loss_override;
+  } else if (ply >= 1) {
+    thread_info.cp_accum_loss =
+        dist(rd) % (ACCUM_EST_MULT * thread_info.cp_loss + 1);
+  }
+
   multipv_search(position, thread_info);
 
   Move best_move = thread_info.best_moves[0];
@@ -36,7 +53,7 @@ void search_human(Position &position, ThreadInfo &thread_info) {
     int m_diff = starting_mat - thread_info.pv_material[i];
     int eval_diff = thread_info.best_scores[0] - thread_info.best_scores[i];
 
-    if (thread_info.game_ply < 7 && eval_diff < 25 &&
+    if (ply < 1 && eval_diff < 25 &&
         thread_info.best_scores[i] > -100 && i < 4) {
       if (dist(rd) % 5 == i) {
         best_move = thread_info.best_moves[i];
@@ -44,7 +61,7 @@ void search_human(Position &position, ThreadInfo &thread_info) {
       }
     }
 
-    if (thread_info.game_ply >= 7 && eval_diff > 0 &&
+    if (ply >= 1 && eval_diff > 0 &&
         eval_diff < thread_info.cp_accum_loss + 10 &&
         thread_info.best_scores[0] < 5000 && !sacrifice) {
       best_move = thread_info.best_moves[i];
@@ -64,9 +81,10 @@ void search_human(Position &position, ThreadInfo &thread_info) {
   if (mistake) {
     thread_info.cp_accum_loss -= mistake;
   }
-  if (thread_info.game_ply >= 7) {
+  if (ply >= 1) {
     thread_info.cp_accum_loss += thread_info.cp_loss;
   }
+  printf("info string accum_loss %i\n", thread_info.cp_accum_loss);
 
   printf("bestmove %s\n", internal_to_uci(position, best_move).c_str());
 }
